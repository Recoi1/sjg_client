+void VIWaitForRetrace() {
+  std::lock_guard lock(retraceMutex);
+  using Clock = std::chrono::steady_clock;
+  const bool pal = aurora::vi::g_renderMode && (aurora::vi::g_renderMode->viTVmode >> 2) == 1;
+  const auto period = std::chrono::nanoseconds(pal ? 20000000 : 16666667);
+  const auto now = Clock::now();
+  nextRetrace += period;
+  // Late decoding has already spent the frame budget; do not add another full frame of sleep.
+  if (nextRetrace < now) nextRetrace = now;
+  std::this_thread::sleep_until(nextRetrace);
+  VIAdvanceRetrace();
+}
+void VIAdvanceRetrace() {
+  std::lock_guard lock(retraceMutex);
+  ++retraceCount;
+  if (preRetrace) preRetrace(retraceCount);
+  currentFrameBuffer = nextFrameBuffer;
+  if (postRetrace) postRetrace(retraceCount);
+}
+u32 VIGetRetraceCount() { std::lock_guard lock(retraceMutex); return retraceCount; }
+u32 VIGetDTVStatus() { return 1; }
+void* VIGetCurrentFrameBuffer() { std::lock_guard lock(retraceMutex); return currentFrameBuffer; }
+void* VIGetNextFrameBuffer() { std::lock_guard lock(retraceMutex); return nextFrameBuffer; }
+void VISetNextFrameBuffer(void* fb) { std::lock_guard lock(retraceMutex); nextFrameBuffer = fb; }
+void VISetBlack(BOOL value) { std::lock_guard lock(retraceMutex); black = value != 0; }
+VIRetraceCallback VISetPreRetraceCallback(VIRetraceCallback cb) {
+  std::lock_guard lock(retraceMutex); return std::exchange(preRetrace, cb);
+}
+VIRetraceCallback VISetPostRetraceCallback(VIRetraceCallback cb) {
+  std::lock_guard lock(retraceMutex); return std::exchange(postRetrace, cb);
+}
+BOOL VIEnableDimming(BOOL value) {
+  std::lock_guard lock(retraceMutex);
+  const bool old = dimming;
+  dimming = value != 0;
+  if (dimming) SDL_EnableScreenSaver(); else SDL_DisableScreenSaver();
+  return old;
+}
+u32 VIGetDimmingCount() {
+  std::lock_guard lock(retraceMutex);
+  LASTINPUTINFO input{sizeof(input)};
+  if (!dimming || !GetLastInputInfo(&input)) return 18000;
+  const u32 idleMs = GetTickCount() - input.dwTime;
+  return idleMs >= 300000 ? 0 : (300000 - idleMs) * 60 / 1000;
+}
+// Digital output has no analog trap filter.
+void VISetTrapFilter(BOOL) {}
+
 void VISetWindowTitle(const char* title) { aurora::window::set_title(title); }
 void VISetWindowFullscreen(bool fullscreen) { aurora::window::set_fullscreen(fullscreen); }
 bool VIGetWindowFullscreen() { return aurora::window::get_fullscreen(); }
