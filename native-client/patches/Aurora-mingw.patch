+bool aurora_reconfigure_graphics(AuroraBackend backend, unsigned msaa) {
+#ifdef AURORA_ENABLE_GX
+  using namespace aurora;
+  if (msaa != 1 && msaa != 4) return false;
+  if (backend == BACKEND_AUTO) backend = PreferredBackendOrder.front();
+  if (std::find(PreferredBackendOrder.begin(), PreferredBackendOrder.end(), backend) == PreferredBackendOrder.end()) return false;
+  const auto previousBackend = g_config.desiredBackend;
+  const auto previousMsaa = g_config.msaa;
+  if (backend == previousBackend && msaa == previousMsaa) return true;
+  gfx::gpu_synchronize();
+  if (backend == previousBackend) {
+    g_config.msaa = msaa;
+    const auto size = window::get_window_size();
+    webgpu::resize_swapchain(size.fb_width, size.fb_height, size.native_fb_width, size.native_fb_height, true);
+    return true;
+  }
+  imgui::shutdown();
+  gfx::shutdown(true);
+  webgpu::shutdown();
+  g_config.msaa = msaa;
+  bool success = webgpu::initialize(backend, g_config.allowCpuAdapter);
+  if (!success) {
+    webgpu::shutdown();
+    g_config.msaa = previousMsaa;
+    AURORA_ASSERT(webgpu::initialize(previousBackend, g_config.allowCpuAdapter), "Cannot restore graphics backend");
+    backend = previousBackend;
+  }
+  g_config.desiredBackend = backend;
+  gfx::initialize();
+  imgui::create_context(); imgui::initialize();
+  return success;
+#else
+  return false;
+#endif
+}
