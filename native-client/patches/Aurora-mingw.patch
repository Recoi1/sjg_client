 #include "../../gx/fifo.hpp"
 
+namespace {
+struct TexturePointers {
+  std::mutex mutex;
+  const void** data = nullptr;
+  u32 size = 0;
+  u32 capacity = 0;
+  ~TexturePointers() { std::free(data); }
+} texturePointers;
+constexpr u32 TexturePointerTag = 0x800000;
+}
+
+u32 AuroraRegisterTexturePointer(const void* data) {
+  if (!data) return TexturePointerTag;
+  std::lock_guard lock(texturePointers.mutex);
+  for (u32 i = 0; i < texturePointers.size; ++i)
+    if (texturePointers.data[i] == data) return TexturePointerTag | (i + 1);
+  if (texturePointers.size == TexturePointerTag - 1) Log.fatal("Native texture pointer table exhausted");
+  if (texturePointers.size == texturePointers.capacity) {
+    const auto capacity = std::min(texturePointers.capacity ? texturePointers.capacity * 2 : 256u, TexturePointerTag - 1);
+    // This table outlives scene heaps, so its storage must use the CRT directly.
+    auto* storage = static_cast<const void**>(std::realloc(texturePointers.data, capacity * sizeof(void*)));
+    if (!storage) Log.fatal("Unable to allocate native texture pointer table");
+    texturePointers.data = storage;
+    texturePointers.capacity = capacity;
+  }
+  texturePointers.data[texturePointers.size++] = data;
+  // shortcut: handles last for the process; reclaim them when display-list/resource lifetimes are ported together.
+  return TexturePointerTag | texturePointers.size;
+}
+
+const void* AuroraResolveTexturePointer(u32 handle) {
+  if (!(handle & TexturePointerTag)) return nullptr;
+  const auto index = handle & (TexturePointerTag - 1);
+  if (!index) return nullptr;
+  std::lock_guard lock(texturePointers.mutex);
+  if (index > texturePointers.size) Log.fatal("Unknown native texture pointer handle {:06x}", handle);
+  return texturePointers.data[index - 1];
+}
+
 static void GXWriteString(const char* label) {
   auto length = strlen(label);
 
