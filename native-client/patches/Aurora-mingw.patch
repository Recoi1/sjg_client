+AtomicFileBatch::AtomicFileBatch() { if (s_batch) throw std::logic_error("Nested file transaction"); s_batch = this; }
+AtomicFileBatch::~AtomicFileBatch() { if (s_batch == this) s_batch = nullptr; }
+bool AtomicFileBatch::stage(const std::filesystem::path& path, std::span<const uint8_t> data) {
+  for (auto& entry : entries) if (entry.path == path) { entry.data.assign(data.begin(), data.end()); return true; }
