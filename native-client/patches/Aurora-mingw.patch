+u32 copy_scale(f32 scale) {
+  CHECK(std::isfinite(scale) && scale > 0.0f, "invalid display copy scale {}", scale);
+  const f32 reciprocal = 256.0f / scale;
+  CHECK(reciprocal >= 1.0f && reciprocal < 512.0f, "display copy scale outside hardware range {}", scale);
