+
+u16 xfb_lines(u16 height, u32 scale) {
+  CHECK(height > 0 && height <= 1024, "invalid EFB height {}", height);
+  u32 result = (height - 1u) * 256u / scale + 1;
+  if (scale > 128 && scale < 256) {
+    while ((scale & 1) == 0) scale >>= 1;
+    if (height % scale == 0) ++result;
+  }
+  return static_cast<u16>(std::min(result, 1024u));
+}
