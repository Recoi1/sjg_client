+bool AtomicFileBatch::commit() {
+  s_batch = nullptr;
+  std::vector<AtomicFileWriter> writers;
+  std::vector<std::optional<std::vector<uint8_t>>> previous;
+  for (const auto& entry : entries) {
+    std::error_code error;
+    const bool exists = std::filesystem::exists(entry.path, error);
+    if (error) return false;
+    previous.push_back(exists ? read_file(entry.path) : std::nullopt);
+    if (exists && !previous.back()) return false;
+    auto writer = open_atomic_file(entry.path);
+    if (!writer || !write_exact(writer.get(), entry.data.data(), entry.data.size())) return false;
+    writers.push_back(std::move(writer));
+  }
+  for (size_t i = 0; i < writers.size(); ++i) if (!writers[i].commit()) {
+    const std::string error = SDL_GetError();
+    for (size_t j = 0; j < i; ++j) {
+      if (previous[j]) {
+        if (!write_file_atomic(entries[j].path, *previous[j])) throw std::runtime_error("Cannot restore settings file after failed apply");
+      } else {
+        std::error_code removeError; std::filesystem::remove(entries[j].path, removeError);
+        if (removeError) throw std::runtime_error("Cannot remove settings file after failed apply");
+      }
+    }
+    restore_error(error); return false;
+  }
+  return true;
+}
