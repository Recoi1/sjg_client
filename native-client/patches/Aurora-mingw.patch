+bool queue_texture_preload(RawTextureReplacement source) {
+  if (!source.width || !source.height || source.width>1024 || source.height>1024 ||
+      !source.mipCount || source.mipCount>std::bit_width(std::max(source.width,source.height)) ||
+      !(source.gxFormat<=6 || source.gxFormat==14)) return false;
+  const auto expected = gx::texture::texture_source_size(source.gxFormat,source.width,source.height,source.mipCount);
+  if (!source.bytes.data() || source.bytes.size()!=expected) return false;
+  const gx::TextureContentKey key{.textureHash=XXH3_128bits(source.bytes.data(),expected),
+      .width=source.width,.height=source.height,.format=source.gxFormat,.mipCount=source.mipCount};
+  std::lock_guard lock{gx::s_preloadMutex};
+  if (gx::s_preloadBytes + expected > gx::PreloadBudgetBytes) return false;
+  for (const auto& pending : gx::s_preloads) if (pending.key==key) return true;
+  ByteBuffer copy{expected};
+  if (!copy.data()) return false;
+  std::memcpy(copy.data(),source.bytes.data(),expected);
+  gx::s_preloadBytes += expected;
+  gx::s_preloads.push_back({key,std::move(copy)});
+  return true;
+}
+bool texture_preloads_pending() {
+  std::lock_guard lock{gx::s_preloadMutex}; return !gx::s_preloads.empty();
+}
