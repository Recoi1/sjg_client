 namespace nw4r {
     namespace ut {
+#ifdef TARGET_PC
+        bool CharStrmReader::NextBounded(const void* end, u16* code) {
+            if (!mCharStrm || !end || !code)
+                throw std::invalid_argument("Invalid font character stream");
+            const auto current = reinterpret_cast<uintptr_t>(mCharStrm);
+            const auto limit = reinterpret_cast<uintptr_t>(end);
+            if (current > limit) throw std::invalid_argument("Font character stream exceeds its bounds");
+            if (current == limit) return false;
+            const auto* bytes = static_cast<const u8*>(mCharStrm);
+            size_t count = 1;
+            if (mReadFunc == &CharStrmReader::ReadNextCharUTF16) count = 2;
+            else if (mReadFunc == &CharStrmReader::ReadNextCharSJIS)
+                count = ((bytes[0] >= 0x81 && bytes[0] < 0xa0) || bytes[0] >= 0xe0) ? 2 : 1;
+            else if (mReadFunc == &CharStrmReader::ReadNextCharUTF8) {
+                if (bytes[0] < 0x80) count = 1;
+                else if (bytes[0] >= 0xc2 && bytes[0] <= 0xdf) count = 2;
+                else if (bytes[0] >= 0xe0 && bytes[0] <= 0xef) count = 3;
+                else throw std::invalid_argument("Unsupported font UTF-8 character");
+            } else if (mReadFunc != &CharStrmReader::ReadNextCharCP1252) {
+                throw std::invalid_argument("Unsupported font character reader");
+            }
+            if (count > limit - current) throw std::invalid_argument("Truncated font character");
+            if (mReadFunc == &CharStrmReader::ReadNextCharUTF8 && count > 1) {
+                for (size_t i = 1; i < count; ++i)
+                    if ((bytes[i] & 0xc0) != 0x80) throw std::invalid_argument("Invalid font UTF-8 continuation");
+                if (count == 3 && ((bytes[0] == 0xe0 && bytes[1] < 0xa0) || (bytes[0] == 0xed && bytes[1] >= 0xa0)))
+                    throw std::invalid_argument("Invalid font UTF-8 character");
+            }
+            alignas(u16) u8 character[4]{};
+            std::memcpy(character, bytes, count);
+            auto copy = *this;
+            copy.mCharStrm = character;
+            const u16 decoded = copy.Next();
+            mCharStrm = bytes + count;
+            *code = decoded;
+            return true;
+        }
+#endif
 
