+        size = sizeof(J3DMtxBuffer::sNoUseNrmMtx);
+    } else if (data) {
+        auto* model = j3dSys.getModel();
+        if (!model || !model->getModelData() || !model->getMtxBuffer())
+            throw std::invalid_argument("Matrix array has no owning model");
+        auto* resource = model->getModelData();
+        auto* buffers = model->getMtxBuffer();
+        u32 count = resource->getDrawMtxNum();
+        // Solid scene heaps have no allocation sizes; each buffer's model defines its extent.
+        if (attr == GX_POS_MTX_ARRAY && data == buffers->mpUserAnmMtx) count = resource->getJointNum();
+        else if (attr == GX_POS_MTX_ARRAY && data == buffers->mpWeightEvlpMtx) count = resource->getWEvlpMtxNum();
+        size = count * stride;
+    }
+    GXSetArraySized(attr, data, size, stride);
+}
+}
