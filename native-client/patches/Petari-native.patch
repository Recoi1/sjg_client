+        for (u32 i = 0; i < archive->mInfoBlock->mNrFiles; ++i) {
+            const auto& file = archive->mFiles[i];
+            const uintptr_t start = reinterpret_cast<uintptr_t>(file.mFileData);
+            if (start && address >= start && address - start < file.mDataSize) return file.mDataSize - (address - start);
+        }
+    }
+    return -1;
+}
+#endif
