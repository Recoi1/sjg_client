+s32 JKRFileLoader::getGlbResourceRemainingSize(const void* resource) {
+    if (!resource) return -1;
+    std::lock_guard lock(sNativeVolumeMutex);
+    const uintptr_t address = reinterpret_cast<uintptr_t>(resource);
+    for (auto* link = sVolumeList.mHead; link; link = link->mNext) {
+        auto* archive = dynamic_cast<JKRArchive*>(static_cast<JKRFileLoader*>(link->mData));
